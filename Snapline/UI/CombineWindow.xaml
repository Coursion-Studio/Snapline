<Window x:Class="Snapline.UI.CombineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapline — Combine" Width="1200" Height="820" MinWidth="940" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="60"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Path Stroke="#DA8FFF" StrokeThickness="2" StrokeLineJoin="Round" Width="24" Height="24"
                Data="M4,4 H10.5 V10.5 H4 Z M13.5,4 H20 V10.5 H13.5 Z M4,13.5 H10.5 V20 H4 Z M13.5,13.5 H20 V20 H13.5 Z">
            <Path.LayoutTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Path.LayoutTransform>
          </Path>
          <TextBlock Text="Combine screenshots" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="Min_Click"/>
          <Button Style="{StaticResource WinButton}" Content="&#xE922;" Click="Max_Click"/>
          <Button Style="{StaticResource WinCloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Preview + settings -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="290"/>
      </Grid.ColumnDefinitions>

      <Grid ClipToBounds="True">
        <Grid.Background>
          <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#1F1F22" Offset="0"/>
            <GradientStop Color="#141416" Offset="1"/>
          </RadialGradientBrush>
        </Grid.Background>
        <Viewbox x:Name="Zoom" Margin="40" Stretch="Uniform">
          <Border x:Name="PreviewHost"/>
        </Viewbox>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="18" Background="#26BF5AF2" HorizontalAlignment="Center">
            <Path Stroke="#DA8FFF" StrokeThickness="1.8" StrokeLineJoin="Round" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M4,4 H10.5 V10.5 H4 Z M13.5,4 H20 V10.5 H13.5 Z M4,13.5 H10.5 V20 H4 Z M13.5,13.5 H20 V20 H13.5 Z">
              <Path.LayoutTransform><ScaleTransform ScaleX="1.3" ScaleY="1.3"/></Path.LayoutTransform>
            </Path>
          </Border>
          <TextBlock Text="Pick two or more screenshots" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
          <TextBlock Text="Click recent captures below, add files, or drop images here." Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,16,20,20">
            <TextBlock Text="LAYOUT" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LayoutRow" GroupName="layout" Style="{StaticResource ToolButton}" Width="56" Height="44" ToolTip="Side by side" IsChecked="True" Checked="Option_Changed">
                <Path Style="{StaticResource Ico}" Data="M3,6 H10.5 V18 H3 Z M13.5,6 H21 V18 H13.5 Z"/>
              </RadioButton>
              <RadioButton x:Name="LayoutColumn" GroupName="layout" Style="{StaticResource ToolButton}" Width="56" Height="44" ToolTip="Stacked" Checked="Option_Changed">
                <Path Style="{StaticResource Ico}" Data="M5,3 H19 V10.5 H5 Z M5,13.5 H19 V21 H5 Z"/>
              </RadioButton>
              <RadioButton x:Name="LayoutGrid" GroupName="layout" Style="{StaticResource ToolButton}" Width="56" Height="44" ToolTip="Grid" Checked="Option_Changed">
                <Path Style="{StaticResource Ico}" Data="M4,4 H10.5 V10.5 H4 Z M13.5,4 H20 V10.5 H13.5 Z M4,13.5 H10.5 V20 H4 Z M13.5,13.5 H20 V20 H13.5 Z"/>
              </RadioButton>
            </StackPanel>

            <StackPanel x:Name="ColumnsRow">
              <Grid><TextBlock Text="COLUMNS" Style="{StaticResource Caption}"/><TextBlock x:Name="ColumnsLabel" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
              <Slider x:Name="ColumnsSlider" Style="{StaticResource SlimSlider}" Minimum="2" Maximum="6" Value="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed"/>
            </StackPanel>

            <Grid><TextBlock Text="SPACING" Style="{StaticResource Caption}"/><TextBlock x:Name="SpacingLabel" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
            <Slider x:Name="SpacingSlider" Style="{StaticResource SlimSlider}" Minimum="0" Maximum="160" Value="40" ValueChanged="Slider_Changed"/>
            <Grid><TextBlock Text="PADDING" Style="{StaticResource Caption}"/><TextBlock x:Name="PaddingLabel" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
            <Slider x:Name="PaddingSlider" Style="{StaticResource SlimSlider}" Minimum="0" Maximum="240" Value="64" ValueChanged="Slider_Changed"/>
            <Grid><TextBlock Text="CORNER RADIUS" Style="{StaticResource Caption}"/><TextBlock x:Name="RadiusLabel" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
            <Slider x:Name="RadiusSlider" Style="{StaticResource SlimSlider}" Minimum="0" Maximum="48" Value="12" ValueChanged="Slider_Changed"/>

            <TextBlock Text="ALIGN" Style="{StaticResource Caption}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
              <RadioButton x:Name="AlignStart" GroupName="align" Style="{StaticResource Chip}" Content="Start" Checked="Option_Changed"/>
              <RadioButton x:Name="AlignCenter" GroupName="align" Style="{StaticResource Chip}" Content="Center" IsChecked="True" Checked="Option_Changed"/>
              <RadioButton x:Name="AlignEnd" GroupName="align" Style="{StaticResource Chip}" Content="End" Checked="Option_Changed"/>
            </StackPanel>

            <CheckBox x:Name="MatchSize" Style="{StaticResource Switch}" Content="Match sizes" IsChecked="True" Click="Option_Changed" Margin="0,10,0,4"/>
            <CheckBox x:Name="ShadowCheck" Style="{StaticResource Switch}" Content="Drop shadow" IsChecked="True" Click="Option_Changed"/>

            <TextBlock Text="BACKGROUND" Style="{StaticResource Caption}"/>
            <WrapPanel x:Name="BgSwatches" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Strips -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
      <StackPanel>
        <TextBlock x:Name="LayoutCaption" Text="IN LAYOUT" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Strip_Wheel">
          <ItemsControl x:Name="LayoutList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="112" Height="70" Margin="0,0,8,0">
                  <Border CornerRadius="8" BorderBrush="#2CFFFFFF" BorderThickness="1">
                    <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
                  </Border>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Style="{StaticResource MiniButton}" Content="&#xE76B;" Tag="{Binding}" Click="MoveLeft_Click" ToolTip="Move left"/>
                    <Button Style="{StaticResource MiniButton}" Content="&#xE711;" Tag="{Binding}" Click="Remove_Click" ToolTip="Remove"/>
                    <Button Style="{StaticResource MiniButton}" Content="&#xE76C;" Tag="{Binding}" Click="MoveRight_Click" ToolTip="Move right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="RECENT CAPTURES  ·  click to add" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Width="80" Height="54" Click="AddFiles_Click" ToolTip="Add image files">
            <StackPanel>
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Center"/>
              <TextBlock Text="Files…" FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Strip_Wheel">
            <ItemsControl x:Name="RecentList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ThumbButton}" Margin="0,0,8,0" Tag="{Binding}" Click="Recent_Click" ToolTip="Add to layout">
                    <Border Width="86" Height="54" CornerRadius="7">
                      <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Bottom bar -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0">
        <TextBlock x:Name="SizeText" Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Foreground="#30D158" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="EditBtn" Style="{StaticResource SecondaryButton}" Click="Edit_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Annotate"/>
            </StackPanel>
          </Button>
          <Button x:Name="CopyBtn" Style="{StaticResource SecondaryButton}" Click="Copy_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Copy"/>
            </StackPanel>
          </Button>
          <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" Click="Save_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Save"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

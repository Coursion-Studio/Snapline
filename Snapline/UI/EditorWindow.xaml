<Window x:Class="Snapline.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapline — Annotate" Width="1280" Height="840" MinWidth="1060" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="54"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="60"/>
    </Grid.RowDefinitions>

    <!-- ===== Top bar ===== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
          <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click"/>
        </StackPanel>

        <StackPanel x:Name="ToolPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Select" ToolTip="Select &amp; move (V)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M6,3 L6,19 L10.2,14.8 L13,21 L15.6,19.8 L12.8,13.8 L18.5,13.6 Z"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Arrow" ToolTip="Arrow (A)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M5,19 L19,5 M10,5 H19 V14"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Rect" ToolTip="Rectangle (R)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M4,6 H20 V18 H4 Z"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Ellipse" ToolTip="Ellipse (E)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M3.5,12 A8.5,7 0 1 0 20.5,12 A8.5,7 0 1 0 3.5,12 Z"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Line" ToolTip="Line (L)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M5,19 L19,5"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Pen" ToolTip="Pen (P)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M4,20 L8.5,19 L19.5,8 L16,4.5 L5,15.5 Z M13.5,7 L17,10.5"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Highlighter" ToolTip="Highlighter (H)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M4,21 H20 M7,17 L7,13 L15,5 L19,9 L11,17 Z M9,11 L13,15"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Text" ToolTip="Text (T)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M5,7 V4.5 H19 V7 M12,4.5 V19.5 M9,19.5 H15"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Counter" ToolTip="Numbered step (N)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M10.5,9.5 L12.5,8 V16"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Pixelate" ToolTip="Pixelate / redact (B)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M4,4 H20 V20 H4 Z M4,9.33 H20 M4,14.66 H20 M9.33,4 V20 M14.66,4 V20"/>
          </RadioButton>
          <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" Tag="Crop" ToolTip="Crop (C)" Checked="Tool_Checked">
            <Path Style="{StaticResource Ico}" Data="M7,3 V17 H21 M3,7 H17 V21"/>
          </RadioButton>

          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="10,0"/>

          <StackPanel x:Name="ColorPanel" Orientation="Horizontal">
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#FF3B30" Checked="Color_Checked" IsChecked="True"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#FF9F0A" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#FFD60A" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#30D158" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#0A84FF" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#BF5AF2" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#FFFFFF" Checked="Color_Checked"/>
            <RadioButton GroupName="color" Style="{StaticResource Swatch}" Background="#1C1C1E" Checked="Color_Checked"/>
          </StackPanel>

          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="10,0"/>

          <RadioButton GroupName="size" Style="{StaticResource SizeDot}" Content="5" Tag="0" ToolTip="Thin" Checked="Size_Checked"/>
          <RadioButton GroupName="size" Style="{StaticResource SizeDot}" Content="8" Tag="1" ToolTip="Medium" Checked="Size_Checked" IsChecked="True"/>
          <RadioButton GroupName="size" Style="{StaticResource SizeDot}" Content="12" Tag="2" ToolTip="Thick" Checked="Size_Checked"/>

          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="10,0"/>

          <ToggleButton x:Name="BgToggle" Style="{StaticResource ChipToggle}" ToolTip="Background, padding &amp; shadow" Checked="BgToggle_Changed" Unchecked="BgToggle_Changed">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Ico}" Data="M3,5 H21 V19 H3 Z M7,9 H17 V15 H7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
              <TextBlock Text="Background" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="Min_Click"/>
          <Button Style="{StaticResource WinButton}" Content="&#xE922;" Click="Max_Click"/>
          <Button Style="{StaticResource WinCloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Canvas + side panel ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Grid x:Name="Stage" ClipToBounds="True">
        <Grid.Background>
          <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#1F1F22" Offset="0"/>
            <GradientStop Color="#141416" Offset="1"/>
          </RadialGradientBrush>
        </Grid.Background>
        <Viewbox x:Name="Zoom" Margin="44" Stretch="Uniform" StretchDirection="DownOnly">
          <Border x:Name="DpiWrap">
            <Border x:Name="CompositionRoot">
              <Border x:Name="ShadowHost">
                <Grid x:Name="SurfaceHost">
                  <Canvas x:Name="TextLayer"/>
                </Grid>
              </Border>
            </Border>
          </Border>
        </Viewbox>
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Opacity="0" IsHitTestVisible="False"
                CornerRadius="10" Background="#F02C2C2E" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="14,8">
          <Border.RenderTransform><TranslateTransform x:Name="ToastSlide"/></Border.RenderTransform>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="ToastText" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="BgPanel" Grid.Column="1" Width="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Width="280" HorizontalAlignment="Left">
          <StackPanel Margin="20,18,20,18">
            <TextBlock Text="Background" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Make screenshots presentation-ready." Foreground="{StaticResource SubText}" FontSize="12" Margin="0,2,0,8"/>
            <CheckBox x:Name="BgEnabled" Style="{StaticResource Switch}" Content="Show background" Click="Bg_Changed"/>
            <TextBlock Text="STYLE" Style="{StaticResource Caption}"/>
            <WrapPanel x:Name="BgSwatches"/>
            <TextBlock Text="PADDING" Style="{StaticResource Caption}"/>
            <Slider x:Name="PadSlider" Style="{StaticResource SlimSlider}" ValueChanged="Bg_ValueChanged"/>
            <TextBlock Text="CORNER RADIUS" Style="{StaticResource Caption}"/>
            <Slider x:Name="RadiusSlider" Style="{StaticResource SlimSlider}" ValueChanged="Bg_ValueChanged"/>
            <CheckBox x:Name="ShadowCheck" Style="{StaticResource Switch}" Content="Drop shadow" IsChecked="True" Click="Bg_Changed" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ===== Bottom bar ===== -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="DragHandle" CornerRadius="8" Background="#2E2E31" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="12,7" Cursor="SizeAll"
                  ToolTip="Drag the finished image into any app or folder">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⠿" FontFamily="Segoe UI Symbol" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource SubText}"/>
              <TextBlock Text="Drag out" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SizeText" Foreground="{StaticResource SubText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource SecondaryButton}" Click="Pin_Click" ToolTip="Float on top of all windows">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE718;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Pin"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Click="Copy_Click" ToolTip="Ctrl+C">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Copy"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Content="Save As…" Click="SaveAs_Click" ToolTip="Ctrl+Shift+S"/>
          <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Ctrl+S">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Save"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
